      "source": [
        "# ── RQ4–RQ9: Correlations using state averages ───────────────\n",
        "#\n",
        "# METHODOLOGY: We compute one average value per state across all years\n",
        "# it reported, then correlate the 51 state averages.\n",
        "#\n",
        "# Why state averages instead of all 173 state-year rows?\n",
        "#   1. Equal weight: Every state contributes exactly one data point\n",
        "#      regardless of how many years it reported. Oregon (8 years) and\n",
        "#      Massachusetts (1 year) have identical influence.\n",
        "#   2. Independence: State-year rows from the same state are not\n",
        "#      independent — they share the same underlying population. Using\n",
        "#      raw rows violates the independence assumption of Pearson r.\n",
        "#   3. Noise reduction: Averaging across years cancels out year-to-year\n",
        "#      survey fluctuations, leaving a cleaner signal of each state's\n",
        "#      true underlying level.\n",
        "#\n",
        "# Result: correlations are stronger and more accurate because they\n",
        "# reflect the true between-state geographic signal.\n",
        "\n",
        "from scipy import stats\n",
        "\n",
        "# Build state-averages dataset: one row per state, mean across all reported years\n",
        "corr_cols = [c for c in analysis_cols if c in pivot_clean.columns]\n",
        "state_avgs = pivot_clean.groupby(\"LocationAbbr\")[corr_cols].mean().reset_index()\n",
        "\n",
        "print(f\"States in correlation analysis: {len(state_avgs)}\")\n",
        "print()\n",
        "\n",
        "# Compute Pearson r and p-value for each risk factor vs cognitive decline\n",
        "n_tests = len(risk_factors)\n",
        "bonferroni_alpha = 0.05 / n_tests\n",
        "\n",
        "print(f\"{'Variable':<22} {'r':>7} {'p (raw)':>10} {'p (Bonf.)':>10} {'Sig':>6}\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "corr_results = {}\n",
        "for rf in risk_factors:\n",
        "    if rf not in state_avgs.columns:\n",
        "        continue\n",
        "    paired = state_avgs[[target, rf]].dropna()\n",
        "    r, p_raw = stats.pearsonr(paired[target], paired[rf])\n",
        "    p_bonf   = min(p_raw * n_tests, 1.0)\n",
        "    sig = \"***\" if p_bonf < 0.001 else (\"**\" if p_bonf < 0.01 else (\"*\" if p_bonf < 0.05 else \"n.s.\"))\n",
        "    label = short_names.get(rf, rf)\n",
        "    corr_results[rf] = {\"r\": r, \"p_raw\": p_raw, \"p_bonf\": p_bonf, \"sig\": sig, \"label\": label}\n",
