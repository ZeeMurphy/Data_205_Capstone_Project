        "print(avg_by_group.round(2))\n",
        "\n",
        "r_age = age_pivot[\"50-64 years\"].corr(age_pivot[\"65 years or older\"])\n",
        "print(f\"\\nCorrelation between age groups: r = {r_age:.2f}\")\n"
