        "# ── Find questions with complete coverage across all states and years ──\n",
        "# We want questions where ALL 51 states reported ALL 8 years\n",
        "\n",
        "# First check all questions without any filters\n",
        "all_q_coverage = df_clean[\n",
        "    (df_clean[\"LocationAbbr\"].isin(us_states)) &\n",
        "    (df_clean[\"Stratification1\"] == \"Overall\")\n",
        "].groupby([\"Question\", \"YearStart\"])[\"LocationAbbr\"].nunique().unstack(fill_value=0)\n",
        "\n",
        "# Find questions where every year has all 51 states\n",
        "complete_questions = []\n",
        "for q in all_q_coverage.index:\n",
        "    row = all_q_coverage.loc[q]\n",
        "    years = [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022]\n",
        "    # Check if all 8 years have at least 45 states reporting\n",
        "    if all(row.get(y, 0) >= 45 for y in years):\n",
        "        min_states = min(row.get(y, 0) for y in years)\n",
        "        complete_questions.append((q, min_states, dict(row)))\n",
        "\n",
        "print(f\"Questions with near-complete coverage across all years:\")\n",
        "print(f\"(Threshold: at least 45 states per year)\")\n",
        "print(\"=\" * 65)\n",
        "for q, min_s, yearly in complete_questions:\n",
        "    print(f\"\\n✅ {q[:80]}\")\n",
        "    print(f\"   Min states in any year: {min_s}\")\n",
        "    for yr in years:\n",
        "        print(f\"   {yr}: {yearly.get(yr, 0)} states\")"
