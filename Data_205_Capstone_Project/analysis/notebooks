      "source": [
        "# Build age group comparison using the BRFSS stratification column\n",
        "# Filter to age-specific rows (50-64 and 65+) with no secondary breakdown\n",
        "age_df = df_clean[\n",
        "    (df_clean[\"Question\"] == target) &\n",
