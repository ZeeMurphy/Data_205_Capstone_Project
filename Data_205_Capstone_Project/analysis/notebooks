        "\n",
        "print()\n",
        "print(f\"Bonferroni correction: α = 0.05 / {n_tests} tests = {bonferroni_alpha:.4f}\")\n",
        "print(\"Significance: *** p<0.001  ** p<0.01  * p<0.05  n.s. not significant\")\n",
        "\n",
        "# Also compute the full correlation matrix on state averages (used by heatmap below)\n",
        "corr_matrix = state_avgs[corr_cols].corr()\n"
      ]
